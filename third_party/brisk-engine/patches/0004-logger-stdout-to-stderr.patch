diff --git a/lib/src/download_engine/log/logger.dart b/lib/src/download_engine/log/logger.dart
index ORIG..PATCH 100644
--- a/lib/src/download_engine/log/logger.dart
+++ b/lib/src/download_engine/log/logger.dart
@@ -52,7 +52,9 @@
     } else {
       logBuffer.write(
