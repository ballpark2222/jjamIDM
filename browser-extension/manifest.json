{
  "manifest_version": 3,
  "name": "jjamIDM",
  "version": "0.1.0",
  "key": "",
  "description": "Send downloads to jjamIDM — segmented, resumable, queued.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "scripting",
    "nativeMessaging",
    "notifications",
    "storage",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "jjamIDM"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
